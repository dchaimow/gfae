# gfae_matlab: gfae with MATLAB R2024b and SPM 25.01.02 for MATLAB (see README.md).
#
# gfae: generic fMRI analysis environment (see README.md), with all software versions pinned:
# - Ubuntu 22.04 base image by digest, apt packages from a fixed snapshot of the Ubuntu archive (2026-05-09)
# - conda base environment pinned to that of gfae_20240902T132553Z (the last image in which ciftify works,
#   nibabel 3.2.2), see pins/
# - all other software by version (release archives, verified by sha256) or by git commit
#
# Build (without root access), from this directory (the %files section refers to files in it):
#   ./build.sh gfae_matlab_ubuntu22.def gfae_matlab
# This file is gfae_ubuntu22.def plus MATLAB; keep the two in sync.
# MATLAB requires a license at runtime: set MLM_LICENSE_FILE (e.g. 27000@kyb-lic-matlab.mpi.localnet, or
# APPTAINERENV_MLM_LICENSE_FILE outside the container).

Bootstrap: docker
# ubuntu:jammy-20260410 (= ubuntu:22.04 at the time of the apt snapshot below)
From: ubuntu@sha256:962f6cadeae0ea6284001009daa4cc9a8c37e75d1f5191cf0eb83fe565b63dd7

%labels
    Description gfae - generic fMRI analysis environment
    Ubuntu 22.04 (ubuntu:jammy-20260410, apt packages from snapshot.ubuntu.com, 20260509T000000Z)
    conda_base_env Miniforge 24.3.0-0, pinned to gfae_20240902T132553Z (python 3.11.9, nibabel 3.2.2, nipype 1.8.5)
    AFNI 26.1.02 (built from source, with SUMA), atlases afni_atlases_dist_2024_0503
    R 4.6.0 (CRAN), AFNI R packages from the CRAN snapshot of 2026-05-09
    FSL 6.0.7.13
    FreeSurfer 7.3.2
    ConnectomeWorkbench 2.0.0
    ciftify 2.3.3
    MSM v3.0FSL (msm_ubuntu_v3)
    ANTs 2.5.3
    nighres 1.5.1
    gradunwarp 1.2.2
    pydeface 2.0.2
    LAYNII 2.7.0
    ITK-SNAP 4.0.2
    convert3d 1.0.0
    dcm2niix v1.0.20240202
    jq 1.7.1
    PALM alpha119
    Octave 6.4.0
    Firefox 140.11.0esr
    MATLAB_Runtime R2017b (v93)
    SPM12_CAT12 CAT12.8.2 r2166
    MATLAB R2024b Update 9 (mpm)
    SPM 25.01.02 (for MATLAB)

%files
    bashrc_conda /opt/etc/bashrc
    pins/base_env_conda_pins.txt /opt/container/base_env_conda_pins.txt
    pins/base_env_pip_pins.txt /opt/container/base_env_pip_pins.txt

%environment
    export PROMPT_COMMAND='. /opt/etc/bashrc; unset PROMPT_COMMAND'
    export PS1="\[\e[0;34m\]gfae> \[\e[0m\]"

    # PALM
    export PATH="/opt/palm:$PATH"

    # CONDA
    export CONDA_DIR=/opt/conda
    export PATH=/opt/conda/bin:$PATH

    # FSL
    export FSLDIR=/opt/fsl
    export PATH=$FSLDIR/bin/:$PATH
    . $FSLDIR/etc/fslconf/fsl.sh

    # Freesurfer
    export FREESURFER_HOME=/opt/freesurfer
    export FS_LICENSE=~/license.txt
    export SUBJECTS_DIR=$FREESURFER_HOME/subjects
    . $FREESURFER_HOME/SetUpFreeSurfer.sh

    # Connectome Workbench
    export PATH=$PATH:/opt/workbench/bin_linux64

    # AFNI (plugins are found next to the programs)
    export PATH="/opt/afni/bin:$PATH"
    export R_LIBS=/opt/R

    # SPM12 with CAT12
    export SPM_HOME=/opt/spm12
    export MCR_HOME=/opt/mcr/v93
    export MCR_INHIBIT_CTF_LOCK=1
    export SPM_HTML_BROWSER=0

    # ANTS
    export PATH=/opt/ants/bin:$PATH

    # Firefox ESR
    export BROWSER=/opt/firefox/firefox

    # ITK-SNAP
    export PATH=/opt/itk-snap/bin:$PATH

    # LAYNII
    export PATH=/opt/laynii:$PATH

    # tools
    export PATH="/opt/dcm2niix:$PATH"
    export C3DPATH="/opt/convert3d"
    export PATH="/opt/convert3d/bin:$PATH"

    # Nighres
    export JCC_JDK=/usr/lib/jvm/java-1.11.0-openjdk-amd64

    # TCL/TK (for FSL, reset by Freesurfer)
    export FSLWISH=/usr/bin/wish
    export FSLTCLSH=/usr/bin/tclsh

    # MATLAB R2024b (installed via mpm)
    export MATLAB_HOME=/opt/MATLAB/R2024b
    export PATH=$MATLAB_HOME/bin:$PATH

    # SPM MATLABPATH
    export MATLABPATH=/opt/spm${MATLABPATH:+:$MATLABPATH}

%post -c /bin/bash
    set -euo pipefail
    chmod 755 /opt/etc/bashrc
    tmp=$(mktemp -d)
    export DEBIAN_FRONTEND=noninteractive

    # download a file and verify its sha256 checksum: fetch <url> <sha256> <destination file>
    fetch() {
        curl -fsSL --retry 5 -o "$3" "$1"
        echo "$2  $3" | sha256sum -c --quiet -
    }

    # Ubuntu packages from a fixed snapshot of the Ubuntu archive; the snapshot is only available via https, so
    # ca-certificates are first installed from the regular archive and then replaced by the version of the snapshot
    apt-get update -qq
    apt-get install -y -q --no-install-recommends ca-certificates
    sed -i -E 's#http://(archive|security)\.ubuntu\.com/ubuntu/?#https://snapshot.ubuntu.com/ubuntu/20260509T000000Z/#' \
        /etc/apt/sources.list
    echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99snapshot
    rm -rf /var/lib/apt/lists/*
    apt-get update -qq
    apt-get install -y -q --no-install-recommends --allow-downgrades \
        "ca-certificates=$(apt-cache madison ca-certificates | awk -F'|' 'NR == 1 {gsub(/ /, "", $2); print $2}')"

    # basic tools
    apt-get install -y -q --no-install-recommends \
        sudo wget curl ca-certificates gnupg unzip bzip2 xz-utils git nano binutils mlocate tree bc \
        bash-completion locales locales-all parallel emacs vim
    sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen && locale-gen

    # runtime and build packages of all software below (build packages are kept, the container is also
    # used for development)
    apt-get install -y -q --no-install-recommends \
        build-essential cmake ninja-build pkgconf \
        `# FSL` \
        file dc mesa-utils pulseaudio libquadmath0 libgtk2.0-0 libgomp1 tcl tk \
        `# AFNI (incl. SUMA)` \
        tcsh xfonts-base xfonts-100dpi xterm xvfb netpbm libjpeg-turbo-progs gsl-bin qhull-bin \
        python-is-python3 python3-matplotlib python3-numpy python3-flask python3-flask-cors python3-pil \
        f2c libf2c2 libf2c2-dev zlib1g-dev libexpat1-dev libqhull-dev \
        libmotif-dev libxm4 libjpeg62 libjpeg-dev libxt-dev libxpm-dev libxmu-dev libxi-dev libx11-dev libxext-dev \
        libglu1-mesa libglu1-mesa-dev libglw1-mesa libglw1-mesa-dev freeglut3 freeglut3-dev libglew2.2 libglew-dev \
        libglib2.0-dev libgsl27 libgsl-dev libosmesa6 \
        `# R packages (AFNI)` \
        libssl-dev libcurl4-openssl-dev libxml2-dev libgfortran-11-dev libgdal-dev libopenblas-dev libnode-dev \
        libudunits2-dev \
        `# PALM` \
        octave liboctave-dev \
        `# nighres` \
        default-jdk python3-dev python3-pip python3-setuptools python3-wheel python3-jcc \
        `# ITK-SNAP` \
        libqt5gui5 libopengl0 \
        `# Firefox` \
        libgtk-3-0 libdbus-glib-1-2 libasound2 libx11-xcb1 libxtst6 libpci-dev libegl-mesa0 libgl1-mesa-dev \
        `# MATLAB Runtime` \
        libncurses5 xorg \
        `# GUI tools` \
        gnome-tweaks gedit evince eog gnome-terminal nautilus

    # R 4.6.0 from CRAN (required by AFNI's R programs; Ubuntu's R 4.1 is too old for its R packages)
    fetch https://cloud.r-project.org/bin/linux/ubuntu/marutter_pubkey.asc \
        ffa734347fd95fd7393f575448ba5e52cf3137067db77224d4857863351e4e8f ${tmp}/cran.asc
    mkdir -p /etc/apt/keyrings
    gpg --dearmor -o /etc/apt/keyrings/cran.gpg ${tmp}/cran.asc
    echo "deb [signed-by=/etc/apt/keyrings/cran.gpg] https://cloud.r-project.org/bin/linux/ubuntu jammy-cran40/" \
        > /etc/apt/sources.list.d/cran.list
    apt-get update -qq
    apt-get install -y -q --no-install-recommends r-base-core=4.6.0-4.2204.0 r-base-dev=4.6.0-4.2204.0
    apt-mark hold r-base-core r-base-dev

    # AFNI 26.1.02, built from source (all programs incl. GUI, SUMA and R programs), before conda is installed, so
    # that no conda libraries are used; nifti and gifti libraries pinned to the commits current at the time of the
    # release (AFNI would otherwise fetch their current versions), gts is pinned by AFNI itself
    git clone -q --depth 1 --branch AFNI_26.1.02 https://github.com/afni/afni.git ${tmp}/afni
    test "$(git -C ${tmp}/afni rev-parse HEAD)" = 2b5f25e2538ab96a168e195ca052de56a7f2c4cb
    git clone -q https://github.com/NIFTI-Imaging/nifti_clib.git ${tmp}/nifti_clib
    git -C ${tmp}/nifti_clib checkout -q 8f72d1165aa62320cc6982d6ddd71a7f6b9924c5
    git clone -q https://github.com/NIFTI-Imaging/gifti_clib.git ${tmp}/gifti_clib
    git -C ${tmp}/gifti_clib checkout -q d3e873d8539d9b469daf7db04093da1d7e73d4f7
    # AFNI's cmake configuration requires the compilers to be set explicitly
    export CC=/usr/bin/gcc CXX=/usr/bin/g++
    cmake -S ${tmp}/afni -B ${tmp}/afni_build -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/afni \
        -DCOMP_GUI=ON \
        -DCOMP_SUMA=ON \
        -DCOMP_RSTATS=ON \
        -DUSE_OMP=ON \
        -DSTANDARD_PYTHON_INSTALL=OFF \
        -DPython_EXECUTABLE=/usr/bin/python3 \
        -DFETCHCONTENT_SOURCE_DIR_NIFTI_CLIB=${tmp}/nifti_clib \
        -DFETCHCONTENT_SOURCE_DIR_GIFTI_CLIB=${tmp}/gifti_clib
    # 32 parallel jobs (the build runs on a shared login node, as it needs internet access)
    ninja -C ${tmp}/afni_build -j 32 install
    unset CC CXX
    # the install does not set the executable bit of the python scripts
    chmod a+x /opt/afni/bin/*.py
    # AFNI templates and atlases (dated release), next to the programs as in AFNI's binary distribution
    fetch https://afni.nimh.nih.gov/pub/dist/atlases/afni_atlases_dist_2024_0503.tgz \
        276a38c859fa15ff925015de776deca578c1c193178f29241748c37744cda747 ${tmp}/afni_atlases.tgz
    tar -xzf ${tmp}/afni_atlases.tgz --strip-components=1 -C /opt/afni/bin

    # AFNI R packages, from the CRAN snapshot of the date of the apt snapshot
    export R_LIBS=/opt/R
    mkdir -p ${R_LIBS}
    /opt/afni/bin/rPkgsInstall -pkgs ALL -site https://packagemanager.posit.co/cran/__linux__/jammy/2026-05-09

    # PALM alpha119, with the gifti mex files compiled for octave
    mkdir -p /opt/palm
    fetch https://s3-us-west-2.amazonaws.com/andersonwinkler/palm/palm-alpha119.tar.gz \
        2ed5e45e0cf902388e53b4652718a4d9a3545276d5dafc01420a74608be6924b ${tmp}/palm.tar.gz
    tar -xzf ${tmp}/palm.tar.gz --strip-components=1 -C /opt/palm
    (cd /opt/palm/fileio/@gifti/private && octave --no-gui --eval 'exit(system("make PLATFORM=octave"))')

    # nighres 1.5.1, built before conda (with Ubuntu's python, JCC and JDK); its java dependencies (which its
    # build script would update to their current versions) pinned to the commits used in gfae_20240902T132553Z;
    # the build directory is kept, so that nighres can also be installed into other conda environments
    export JCC_JDK=/usr/lib/jvm/java-1.11.0-openjdk-amd64
    git clone -q https://github.com/nighres/nighres /opt/nighres_build
    git -C /opt/nighres_build checkout -q ea6dd98235e2a62b30768a3107b4365875536f13
    git clone -q https://github.com/piloubazin/cbstools-public.git /opt/nighres_build/cbstools-public
    git -C /opt/nighres_build/cbstools-public checkout -q -B release-1.5.1 a653e78f8b1f5b7e353d2bf7b2e3e2fc2c4927bf
    git clone -q https://github.com/piloubazin/imcn-imaging.git /opt/nighres_build/imcn-imaging
    git -C /opt/nighres_build/imcn-imaging checkout -q -B release-1.5.1 51d183d832db01e22960b7655850fed4d360f99b
    git clone -q https://github.com/piloubazin/fbpa-tools.git /opt/nighres_build/fbpa-tools
    git -C /opt/nighres_build/fbpa-tools checkout -q -B release-1.5.1 15d50ea085b50c0c0c8c7a614a5c54eec1ae9360
    sed -i -E '/^\s*git pull\s*$/d' /opt/nighres_build/build.sh
    (cd /opt/nighres_build && ./build.sh)

    # Miniforge 24.3.0 with the conda base environment pinned to that of gfae_20240902T132553Z (ciftify 2.3.3
    # requires nibabel 3.2.2); pip packages without dependencies and without build isolation (they are built
    # with the pinned setuptools and numpy)
    fetch https://github.com/conda-forge/miniforge/releases/download/24.3.0-0/Miniforge3-24.3.0-0-Linux-x86_64.sh \
        23367676b610de826f50f7ddc91139a816d4b59bd4c69cc9b6082d9b2e7fe8a3 ${tmp}/Miniforge3.sh
    bash ${tmp}/Miniforge3.sh -b -p /opt/conda
    /opt/conda/bin/conda config --system --set auto_update_conda false
    /opt/conda/bin/conda config --system --set show_channel_urls true
    /opt/conda/bin/conda install -y --name base --override-channels -c conda-forge \
        --file /opt/container/base_env_conda_pins.txt
    pip_install="/opt/conda/bin/python -m pip install --no-deps --no-build-isolation --no-cache-dir"
    ${pip_install} -r /opt/container/base_env_pip_pins.txt

    # nighres (built above)
    ${pip_install} /opt/nighres_build

    # gradunwarp 1.2.2 (HCP version)
    git clone -q https://github.com/Washington-University/gradunwarp.git ${tmp}/gradunwarp
    git -C ${tmp}/gradunwarp checkout -q ff082ef59af628806aae7f5d767bcf867674ac0c
    ${pip_install} ${tmp}/gradunwarp

    # FSL 6.0.7.13 (the release manifest pins all FSL packages), with a fixed version of the installer; --conda: use
    # conda instead of mamba, as installers >= 3.21 call mamba with an option (--rc-file) that mamba 1.5.8 does
    # not support
    fetch https://git.fmrib.ox.ac.uk/fsl/conda/installer/-/raw/3.21.0/fsl/installer/fslinstaller.py \
        0a63084cb5f1d67a39e0732a3d6cbc00c183eda85b77e94269c2ed2f5ea0064a ${tmp}/fslinstaller.py
    /opt/conda/bin/python ${tmp}/fslinstaller.py -d /opt/fsl -V 6.0.7.13 --miniconda /opt/conda --conda \
        --extras_dir /opt/conda/envs

    # FreeSurfer 7.3.2 (7.4 changed mris_convert in a way that is incompatible with ciftify)
    fetch https://surfer.nmr.mgh.harvard.edu/pub/dist/freesurfer/7.3.2/freesurfer_ubuntu22-7.3.2_amd64.deb \
        612f7c8ce90abfc380eb990500603124b85d9aa11b33300a74f098b1f88c6b0b ${tmp}/freesurfer.deb
    apt-get install -y -q ${tmp}/freesurfer.deb
    ln -s /usr/local/freesurfer/7.3.2 /opt/freesurfer

    # Connectome Workbench 2.0.0
    fetch https://www.humanconnectome.org/storage/app/media/workbench/workbench-linux64-v2.0.0.zip \
        29d0687adfb8fdcb709ecb574838265c70f5faf1ef2d5cd08598869a04988bd3 ${tmp}/workbench.zip
    unzip -q ${tmp}/workbench.zip -d /opt

    # MSM (HCP version, required by ciftify, replaces the msm of FSL)
    mv /opt/fsl/bin/msm /opt/fsl/bin/msm_fsl
    fetch https://github.com/ecr05/MSM_HOCR/releases/download/v3.0FSL/msm_ubuntu_v3 \
        3c0cbdb709f7263e08827f44aa57bbaa0eff2647291426ec8a43aa911e11d6e7 /opt/fsl/bin/msm
    chmod +x /opt/fsl/bin/msm

    # ANTs 2.5.3
    fetch https://github.com/ANTsX/ANTs/releases/download/v2.5.3/ants-2.5.3-ubuntu-22.04-X64-gcc.zip \
        d7dc8ab1fe0829081804e0b356461c3af13c0fe8353bb59cd27de1a1689f1193 ${tmp}/ants.zip
    unzip -q ${tmp}/ants.zip -d /opt/
    mv /opt/ants-2.5.3 /opt/ants

    # Firefox ESR 140.11.0 (Mozilla's release archive; Ubuntu's firefox is a snap, which does not work in apptainer)
    fetch https://ftp.mozilla.org/pub/firefox/releases/140.11.0esr/linux-x86_64/en-US/firefox-140.11.0esr.tar.xz \
        2c1de25ad00a9d6e23c66d271b73bfec9acef18c3c049869e7d330eba44ec308 ${tmp}/firefox.tar.xz
    tar -xJf ${tmp}/firefox.tar.xz -C /opt
    ln -s /opt/firefox/firefox /usr/local/bin/firefox
    ln -s /opt/firefox/firefox /usr/local/bin/firefox-esr

    # ITK-SNAP 4.0.2
    mkdir -p /opt/itk-snap
    fetch https://sourceforge.net/projects/itk-snap/files/itk-snap/4.0.2/itksnap-4.0.2-Linux-gcc64.tar.gz/download \
        9968d8be6c9608fb5bfaf37b318b40da349b1ce69dbf273f461478b177790193 ${tmp}/itksnap.tar.gz
    tar -xzf ${tmp}/itksnap.tar.gz --strip-components=1 -C /opt/itk-snap
    find /opt/itk-snap/ -type f -name '*.so.*' -print0 | xargs -0 strip --remove-section=.note.ABI-tag

    # LAYNII 2.7.0
    fetch https://github.com/layerfMRI/LAYNII/releases/download/v2.7.0/LayNii_v2.7.0_Linux64.zip \
        f90d37caa51f73376992af1a474b2b9e67125ddf8e505d827f7ec317090cb6cb ${tmp}/laynii.zip
    unzip -q ${tmp}/laynii.zip -d /opt/laynii

    # jq 1.7.1
    fetch https://github.com/jqlang/jq/releases/download/jq-1.7.1/jq-linux-amd64 \
        5942c9b0934e510ee61eb3e30273f1b3fe2590df93933a93d7c58b81d19c8ff5 /usr/local/bin/jq
    chmod +x /usr/local/bin/jq

    # dcm2niix v1.0.20240202
    mkdir -p /opt/dcm2niix
    fetch https://github.com/rordenlab/dcm2niix/releases/download/v1.0.20240202/dcm2niix_lnx.zip \
        269debc463857a999a9b48f677218dae287b58f5300f161d7fad284116a6321b ${tmp}/dcm2niix.zip
    unzip -q ${tmp}/dcm2niix.zip -d /opt/dcm2niix
    chmod +x /opt/dcm2niix/dcm2niix

    # convert3d 1.0.0
    mkdir -p /opt/convert3d
    fetch https://sourceforge.net/projects/c3d/files/c3d/1.0.0/c3d-1.0.0-Linux-x86_64.tar.gz/download \
        2e0551fddb8a9306800f780a08d80873b955536ec65959fa1123ea473e12d77b ${tmp}/c3d.tar.gz
    tar -xzf ${tmp}/c3d.tar.gz --strip-components=1 -C /opt/convert3d

    # MATLAB Runtime R2017b (v93)
    mkdir -p /opt/mcr
    fetch https://ssd.mathworks.com/supportfiles/downloads/R2017b/deployment_files/R2017b/installers/glnxa64/MCR_R2017b_glnxa64_installer.zip \
        a01619b30f8cfd34a9a9cefe8323a2ada22a65722fc13b823dae36086ddd259f ${tmp}/mcr.zip
    unzip -q ${tmp}/mcr.zip -d ${tmp}/mcr_installer
    ${tmp}/mcr_installer/install -mode silent -agreeToLicense yes -destinationFolder /opt/mcr
    mv /opt/mcr/v93/bin/glnxa64/libfreetype.so.6.11.1 /opt/mcr/v93/bin/glnxa64/libfreetype.so.6.11.1.bak

    # SPM12 with CAT12.8.2 r2166 (standalone, MATLAB Runtime R2017b)
    fetch https://www.neuro.uni-jena.de/cat12/CAT12.8.2_r2166_R2017b_MCR_Linux.zip \
        e4e05fb12dd978c44307080e2cd6a98e2dc5034ea46a7976c9123a21898417be ${tmp}/cat12.zip
    unzip -q ${tmp}/cat12.zip -d ${tmp}
    mv ${tmp}/CAT12.8.2_r2166_R2017b_MCR_Linux /opt/spm12
    chmod +x /opt/spm12/run_spm12.sh /opt/spm12/spm12
    # single call (to build spm12.ctf while we have write permissions)
    /opt/spm12/run_spm12.sh /opt/mcr/v93 function exit
    # set up single spm executable
    printf '#!/bin/bash\n/opt/spm12/run_spm12.sh /opt/mcr/v93 "$@"' > /opt/spm12/spm12_mcr/bin/spm12
    chmod +x /opt/spm12/spm12_mcr/bin/spm12
    ln -s /opt/spm12/spm12_mcr/bin/spm12 /usr/local/bin/spm12

    # MATLAB R2024b Update 9 via mpm (MathWorks Package Manager; mpm itself is only available in its current
    # version); no license required at build time, the license is checked at runtime via MLM_LICENSE_FILE
    apt-get install -y -q --no-install-recommends \
        libasound2 libatomic1 libc6 libcairo-gobject2 libcairo2 libcap2 libcrypt1 libcups2 libdrm2 \
        libfontconfig1 libfribidi0 libgbm1 libgdk-pixbuf-2.0-0 libgl1 libglib2.0-0 \
        libgstreamer-plugins-base1.0-0 libgstreamer1.0-0 libgtk-3-0 libice6 libltdl7 libmd0 libnettle8 \
        libnspr4 libnss3 libpam0g libpango-1.0-0 libpangocairo-1.0-0 libpangoft2-1.0-0 libpixman-1-0 \
        libsndfile1 libtirpc3 libudev1 libuuid1 libwayland-client0 libxcomposite1 libxcursor1 libxdamage1 \
        libxfixes3 libxfont2 libxft2 libxinerama1 libxrandr2 libxt6 libxtst6 libxxf86vm1 \
        make net-tools procps zlib1g
    curl -fsSL --retry 5 -o ${tmp}/mpm https://www.mathworks.com/mpm/glnxa64/mpm
    chmod +x ${tmp}/mpm
    ${tmp}/mpm install \
        --release=R2024bU9 \
        --destination=/opt/MATLAB/R2024b \
        --products \
            MATLAB \
            Bioinformatics_Toolbox \
            Curve_Fitting_Toolbox \
            Deep_Learning_Toolbox \
            Financial_Toolbox \
            Global_Optimization_Toolbox \
            Image_Processing_Toolbox \
            MATLAB_Compiler \
            Mapping_Toolbox \
            Instrument_Control_Toolbox \
            Medical_Imaging_Toolbox \
            Optimization_Toolbox \
            Parallel_Computing_Toolbox \
            Reinforcement_Learning_Toolbox \
            Robotics_System_Toolbox \
            Signal_Processing_Toolbox \
            Statistics_and_Machine_Learning_Toolbox \
            Symbolic_Math_Toolbox \
            Wavelet_Toolbox
    mkdir -p /usr/local/MATLAB
    ln -s /opt/MATLAB/R2024b /usr/local/MATLAB/R2024b

    # SPM 25.01.02 (for MATLAB)
    fetch https://github.com/spm/spm/releases/download/25.01.02/spm_25.01.02.zip \
        562c8036aa11c0d2cfe0fbff123f482c3ec8cb5ef56be521af26caae5481db2a ${tmp}/spm.zip
    unzip -q ${tmp}/spm.zip -d /opt

    # clean up
    /opt/conda/bin/conda clean --all --yes
    rm -rf ~/.cache/pip/* /var/lib/apt/lists/* ${tmp}

%test
    set -e
    # conda base environment (pinned to gfae_20240902T132553Z); ciftify requires nibabel < 4
    /opt/conda/bin/python -c "
import sys, nibabel, numpy, nipype, ciftify, ciftify.config, pydeface, gradunwarp.core.unwarp_resample, nighres
assert sys.version.split()[0] == '3.11.9', sys.version
assert nibabel.__version__ == '3.2.2', nibabel.__version__
assert numpy.__version__ == '1.26.4', numpy.__version__
assert nipype.__version__ == '1.8.5', nipype.__version__
"
    (cd /tmp && /opt/conda/bin/python -c "import nighresjava; nighresjava.initVM(initialheap='500m', maxheap='500m')")
    # versions of the main software
    test "$(cat ${FSLDIR}/etc/fslversion)" = "6.0.7.13"
    grep -q "7.3.2" ${FREESURFER_HOME}/build-stamp.txt
    wb_command -version | grep -q "Version: 2.0.0"
    afni -ver | grep -q "AFNI_26.1.02"
    antsRegistration --version | grep -q "2.5.3"
    R --version | awk 'NR == 1' | grep -q "R version 4.6.0"
    octave --version | awk 'NR == 1' | grep -q "6.4.0"
    firefox --version 2>/dev/null | grep -q "140.11.0esr"
    c3d -version | grep -q "1.0.0"
    dcm2niix --version 2>&1 | grep -q "v1.0.20240202"
    test "$(jq --version)" = "jq-1.7.1"
    # programs of all packages
    for program in 3dTcat 3dvolreg 3dDeconvolve 3dMVM afni_proc.py 1d_tool.py suma rPkgsInstall \
                   fslmaths fsleyes slicetimer recon-all mri_convert mris_convert wb_command \
                   ciftify_recon_all msm msm_fsl antsRegistration antsApplyTransforms \
                   LN2_LAYERS LN_MP2RAGE_DNOISE itksnap c3d dcm2niix palm octave spm12 \
                   gradient_unwarp.py pydeface jq parallel bc tcsh firefox emacs vim; do
        command -v ${program} > /dev/null || { echo "missing: ${program}"; exit 1; }
    done
    # AFNI: python scripts must be executable (command -v alone does not check that), libraries complete,
    # templates installed
    test -z "$(find /opt/afni/bin -maxdepth 1 -type f -name '*.py' ! -perm -a+x)" || { echo "not executable: AFNI python scripts"; exit 1; }
    1d_tool.py -ver > /dev/null
    if ldd /opt/afni/bin/afni /opt/afni/bin/suma | grep -q "not found"; then echo "missing: AFNI libraries"; exit 1; fi
    test -f /opt/afni/bin/MNI152_2009_template_SSW.nii.gz
    # AFNI R packages
    Rscript -e 'for (p in c("afex", "phia", "snow", "nlme", "lme4", "lmerTest", "gamm4", "data.table", "paran", "psych", "brms", "corrplot", "metafor")) library(p, character.only = TRUE)' > /dev/null 2>&1 \
        || { echo "missing: AFNI R packages"; exit 1; }
    # PALM gifti mex files for octave
    test -f /opt/palm/fileio/@gifti/private/xml_parser.mex
    # MATLAB (without license, only the installation) and SPM for MATLAB
    grep -q "<release>R2024b</release>" ${MATLAB_HOME}/VersionInfo.xml
    grep -q "<description>Update 9</description>" ${MATLAB_HOME}/VersionInfo.xml
    command -v matlab > /dev/null || { echo "missing: matlab"; exit 1; }
    test -f /opt/spm/spm.m
    echo "all tests passed"
