Bootstrap: docker
From: nvidia/cuda:11.2.2-devel-ubuntu18.04

%environment
    # CONDA
    export CONDA_DIR=/opt/conda
    export PATH=/opt/conda/bin:$PATH

    # FSL
    export FSLDIR=/opt/fsl
    export PATH=$FSLDIR/bin/:$PATH
    . $FSLDIR/etc/fslconf/fsl.sh

%post
    tmp=$(mktemp -d)
    
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq
    apt-get install -y -q --no-install-recommends \
            sudo \
            wget \
            curl \
            ca-certificates \
            unzip \
            bzip2 \
            git \
            nano \
            binutils \
            mlocate \
            tree \
            bc \
            bash-completion \
            locales \
            locales-all

    # Condaforge 24.3.0
    export PATH=/opt/conda/bin:$PATH
    wget https://github.com/conda-forge/miniforge/releases/download/24.3.0-0/Miniforge3-24.3.0-0-Linux-x86_64.sh -P ${tmp}
    bash ${tmp}/Miniforge3-24.3.0-0-Linux-x86_64.sh -b -p /opt/conda
    conda update -yq -nbase conda
    conda config --system --set auto_update_conda false
    conda config --system --set show_channel_urls true
    # install; nibabel 3.2 because of ciftify issue
    conda install -y  --name base \
            "python" \
            "nipype" \
            "notebook" \
            "jupyterlab" \
            "numpy<2" \
            "scipy" \
            "nibabel=3.2" \
            "seaborn>=0.9.0" \
            "nilearn>=0.5.0" \
            "matplotlib>=2.2.2" \
            "pandas>=0.23.4" \
            "flask>=2.1.2" \
            "flask-cors>=3.0.10" \
            "pillow"

    # for fsl-cuda
    apt-get install -y --fix-missing \
        libpng-tools \
        libpng-dev \
        libmng2 \
        libgomp1 \
        libquadmath0 \
        curl \
        python3 \
        python \
        bc

    # FSL
    # apt-get install -y \
    #   file            \
    #   dc              \
    #   mesa-utils      \
    #   pulseaudio      \
    #   libquadmath0    \
    #   libgtk2.0-0     \
    #   firefox         \
    #   libgomp1 \
    #   tcl \
    #   tk

    # curl -fsSL https://fsl.fmrib.ox.ac.uk/fsldownloads/fslconda/releases/fslinstaller.py | \
        # python - -d /opt/fsl -V 6.0.7.13 --miniconda /opt/conda --extras_dir /opt/conda/envs

    curl -fsSL https://git.fmrib.ox.ac.uk/fsl/installer/-/raw/3.3.0/fslinstaller.py | \
        python - -d /opt/fsl -V 6.0.4

    rm /opt/fsl/bin/eddy 
    ln -s /opt/fsl/bin/eddy_cuda /opt/fsl/bin/eddy

    #FSL eyes modification: needs opengl , fonts and locale
    apt-get install -y \
        cmake \
        pkg-config \
        mesa-utils \
        libglu1-mesa-dev \
        freeglut3-dev \
        mesa-common-dev \
        libglew-dev \
        libglfw3-dev \
        libglm-dev \
        libao-dev \
        libmpg123-dev

    echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" | debconf-set-selections

    apt-get install -y --no-install-recommends fontconfig ttf-mscorefonts-installer locales

    fc-cache -f -v

    

    # Conda clean up
    sync && conda clean --all --yes && sync
    rm -rf ~/.cache/pip/*

    # Clean up
    rm -rf /var/lib/apt/lists/*
    rm -rf ${tmp}